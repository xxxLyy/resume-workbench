<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lhx.resume-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/xxxly/resume/server.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>RESUME_LOG_FILE</key><string>/Users/xxxly/resume/logs/resume-server.log</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 注意：launchd 在启动 node 之前就会打开下面的日志文件，bootstrap 前父目录 ~/resume/logs/ 必须已存在（mkdir -p ~/resume/logs） -->
  <key>StandardOutPath</key><string>/Users/xxxly/resume/logs/resume-server.log</string>
  <key>StandardErrorPath</key><string>/Users/xxxly/resume/logs/resume-server.log</string>
</dict>
</plist>
